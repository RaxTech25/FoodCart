# Environment variables
# PostgreSQL (Neon / Supabase / any Postgres)
# Example Neon URL: postgres://user:password@host/dbname?sslmode=require
DATABASE_URL="postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Seed endpoint protection
SEED_SECRET="replace-with-strong-secret"

# If integrating SMS/Email later
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
SENDGRID_API_KEY=""